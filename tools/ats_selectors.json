  ],
  "fallback_regex": {
    "first_name": ["first\\s*name", "given\\s*name", "forename"],
    "last_name": ["last\\s*name", "surname", "family\\s*name"],
    "full_name": ["full\\s*name", "your\\s*name", "^name$"],
    "email": ["e-?mail", "email\\s*address"],
    "phone": ["phone", "mobile", "contact\\s*number", "tel", "cell\\s*phone"],
    "resume_upload": ["resume", "cv", "curriculum\\s*vitae", "upload\\s*resume"],
    "cover_letter_upload": ["cover\\s*letter", "letter\\s*of\\s*motivation"],
    "cover_letter_text": ["cover\\s*letter", "additional\\s*information", "message\\s*to\\s*hiring\\s*manager"],
    "linkedin_url": ["linkedin", "linked\\s*in"],
    "github_url": ["github", "git\\s*hub"],
    "portfolio_url": ["portfolio", "website", "personal\\s*site"],
    "current_company": ["current\\s*company", "employer", "company"],
    "current_title": ["current\\s*title", "job\\s*title", "role"],
    "location": ["location", "address"],
    "city": ["city", "town"],
    "country": ["country", "nation"]
  }
}
