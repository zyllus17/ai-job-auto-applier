{
  "platforms": [
    {
      "platform_name": "Greenhouse",
      "url_pattern": "(?:boards\\.greenhouse\\.io|board\\.greenhouse\\.io)",
      "selectors": {
        "first_name": "#first_name",
        "last_name": "#last_name",
        "full_name": null,
        "email": "#email",
        "phone": "#phone",
        "resume_upload": "input#resume[type=\"file\"], button[aria-label=\"Attach Resume/CV\"]",
        "cover_letter_upload": "input#cover_letter[type=\"file\"], button[aria-label=\"Attach Cover Letter\"]",
        "cover_letter_text": "textarea#cover_letter_text",
        "linkedin_url": "input[autocomplete=\"custom-question-linkedin-profile\"], input[id*=\"linkedin\"]",
        "github_url": "input[autocomplete=\"custom-question-github-profile\"], input[id*=\"github\"]",
        "portfolio_url": "input[autocomplete=\"custom-question-portfolio\"], input[id*=\"portfolio\"]",
        "current_company": "input[id*=\"current_company\"]",
        "current_title": "input[id*=\"current_title\"]",
        "location": "input[id*=\"location\"]",
        "city": null,
        "country": null,
        "submit_button": "button#submit_app, input#submit_app",
        "next_button": null
      },
      "notes": "Greenhouse forms are typically single-page. Some fields might have dynamic IDs, so fallback regex is recommended if exact IDs fail."
    },
    {
      "platform_name": "Lever",
      "url_pattern": "jobs\\.lever\\.co",
      "selectors": {
        "first_name": "input[name=\"name\"]",
        "last_name": null,
        "full_name": "input[name=\"name\"]",
        "email": "input[name=\"email\"]",
        "phone": "input[name=\"phone\"]",
        "resume_upload": "input[name=\"resume\"][type=\"file\"]",
        "cover_letter_upload": "input[name=\"coverLetter\"][type=\"file\"]",
        "cover_letter_text": "textarea[name=\"comments\"]",
        "linkedin_url": "input[name=\"urls[LinkedIn]\"]",
        "github_url": "input[name=\"urls[GitHub]\"]",
        "portfolio_url": "input[name=\"urls[Portfolio]\"]",
        "current_company": "input[name=\"org\"]",
        "current_title": null,
        "location": "input[name=\"location\"]",
        "city": null,
        "country": null,
        "submit_button": "button.postings-btn[type=\"submit\"]",
        "next_button": null
      },
      "notes": "Lever uses a single 'name' field for full name. Cover letter is often just a text area for 'Additional information'."
    },
    {
      "platform_name": "Ashby",
      "url_pattern": "jobs\\.ashbyhq\\.com",
      "selectors": {
        "first_name": "aria-label=First Name",
        "last_name": "aria-label=Last Name",
        "full_name": "aria-label=Name",
        "email": "aria-label=Email",
        "phone": "aria-label=Phone",
        "resume_upload": "input[type=\"file\"][accept*=\"pdf\"]",
        "cover_letter_upload": "input[type=\"file\"][accept*=\"pdf\"]",
        "cover_letter_text": "aria-label=Cover Letter",
        "linkedin_url": "aria-label=LinkedIn Profile",
        "github_url": "aria-label=GitHub Profile",
        "portfolio_url": "aria-label=Portfolio",
        "current_company": "aria-label=Current Company",
        "current_title": "aria-label=Current Title",
        "location": "aria-label=Location",
        "city": "aria-label=City",
        "country": "aria-label=Country",
        "submit_button": "button[type=\"submit\"]",
        "next_button": "button:has-text(\"Next\")"
      },
      "notes": "Ashby relies heavily on ARIA labels. Best approached using getByLabel locators in Playwright."
    },
    {
      "platform_name": "Workday",
      "url_pattern": "myworkdayjobs\\.com",
      "selectors": {
        "first_name": "[data-automation-id=\"legalNameSection_firstName\"]",
        "last_name": "[data-automation-id=\"legalNameSection_lastName\"]",
        "full_name": null,
        "email": "[data-automation-id=\"email\"]",
        "phone": "[data-automation-id=\"phone-number\"]",
        "resume_upload": "[data-automation-id=\"file-upload-input-ref\"]",
        "cover_letter_upload": "[data-automation-id=\"file-upload-input-ref\"]",
        "cover_letter_text": null,
        "linkedin_url": "[data-automation-id=\"linkedin\"]",
        "github_url": "[data-automation-id=\"github\"]",
        "portfolio_url": "[data-automation-id=\"portfolio\"]",
        "current_company": "[data-automation-id=\"company\"]",
        "current_title": "[data-automation-id=\"jobTitle\"]",
        "location": "[data-automation-id=\"addressSection_city\"]",
        "city": "[data-automation-id=\"addressSection_city\"]",
        "country": "[data-automation-id=\"addressSection_countryRegion\"]",
        "submit_button": "[data-automation-id=\"submit\"]",
        "next_button": "[data-automation-id=\"bottom-navigation-next-button\"]"
      },
      "notes": "Workday is a multi-step wizard. Always uses data-automation-id attributes."
    },
    {
      "platform_name": "SmartRecruiters",
      "url_pattern": "(?:smartrecruiters\\.com|careers\\.smartrecruiters\\.com)",
      "selectors": {
        "first_name": "[data-test=\"first-name-input\"]",
        "last_name": "[data-test=\"last-name-input\"]",
        "full_name": null,
        "email": "[data-test=\"email-input\"]",
        "phone": "[data-test=\"phone-input\"]",
        "resume_upload": "[data-test=\"file-upload-input\"]",
        "cover_letter_upload": "[data-test=\"cover-letter-upload\"]",
        "cover_letter_text": "[data-test=\"cover-letter-textarea\"]",
        "linkedin_url": "[data-test=\"linkedin-input\"]",
        "github_url": "[data-test=\"github-input\"]",
        "portfolio_url": "[data-test=\"portfolio-input\"]",
        "current_company": "[data-test=\"current-company-input\"]",
        "current_title": "[data-test=\"current-title-input\"]",
        "location": "[data-test=\"location-input\"]",
        "city": "[data-test=\"city-input\"]",
        "country": "[data-test=\"country-input\"]",
        "submit_button": "[data-test=\"submit-button\"]",
        "next_button": "[data-test=\"next-button\"]"
      },
      "notes": "Relies heavily on data-test attributes."
    },
    {
      "platform_name": "LinkedIn Easy Apply",
      "url_pattern": "linkedin\\.com/jobs/view/.*\\?apply=true",
      "selectors": {
        "first_name": "input[id*=\"first-name\"]",
        "last_name": "input[id*=\"last-name\"]",
        "full_name": null,
        "email": "input[id*=\"email\"]",
        "phone": "input[id*=\"phone\"]",
        "resume_upload": "input[type=\"file\"][name*=\"file\"]",
        "cover_letter_upload": null,
        "cover_letter_text": null,
        "linkedin_url": null,
        "github_url": null,
        "portfolio_url": null,
        "current_company": null,
        "current_title": null,
        "location": null,
        "city": null,
        "country": null,
        "submit_button": "button[aria-label*=\"Submit\"]",
        "next_button": "button[aria-label*=\"Continue\"], button[aria-label*=\"Next\"]"
      },
      "notes": "Modal dialog based. Multi-step forms inside div.jobs-easy-apply-content."
    },
    {
      "platform_name": "Indeed",
      "url_pattern": "indeed\\.com/apply",
      "selectors": {
        "first_name": "input[id=\"input-firstName\"]",
        "last_name": "input[id=\"input-lastName\"]",
        "full_name": null,
        "email": "input[id=\"input-email\"]",
        "phone": "input[id=\"input-phoneNumber\"]",
        "resume_upload": "input[type=\"file\"]",
        "cover_letter_upload": "input[type=\"file\"]",
        "cover_letter_text": "textarea[id=\"input-coverLetter\"]",
        "linkedin_url": "input[id=\"input-linkedin\"]",
        "github_url": "input[id=\"input-github\"]",
        "portfolio_url": "input[id=\"input-portfolio\"]",
        "current_company": "input[id=\"input-companyName\"]",
        "current_title": "input[id=\"input-jobTitle\"]",
        "location": "input[id=\"input-location\"]",
        "city": "input[id=\"input-city\"]",
        "country": "input[id=\"input-country\"]",
        "submit_button": "button:has-text(\"Submit application\")",
        "next_button": "button:has-text(\"Continue\")"
      },
      "notes": "Standard multi-step form process."
    },
    {
      "platform_name": "Naukri",
      "url_pattern": "naukri\\.com",
      "selectors": {
        "first_name": "input[name=\"firstName\"]",
        "last_name": "input[name=\"lastName\"]",
        "full_name": "input[name=\"name\"]",
        "email": "input[name=\"email\"]",
        "phone": "input[name=\"mobile\"]",
        "resume_upload": "input[type=\"file\"]",
        "cover_letter_upload": "input[type=\"file\"]",
        "cover_letter_text": "textarea[name=\"coverLetter\"]",
        "linkedin_url": "input[name=\"linkedin\"]",
        "github_url": "input[name=\"github\"]",
        "portfolio_url": "input[name=\"portfolio\"]",
        "current_company": "input[name=\"company\"]",
        "current_title": "input[name=\"designation\"]",
        "location": "input[name=\"location\"]",
        "city": "input[name=\"city\"]",
        "country": "input[name=\"country\"]",
        "submit_button": "button[type=\"submit\"]",
        "next_button": "button:has-text(\"Next\")"
      },
      "notes": "India's largest portal. Forms can vary slightly based on employer."
    },
    {
      "platform_name": "Monster",
      "url_pattern": "monster\\.com",
      "selectors": {
        "first_name": "input[name=\"firstName\"]",
        "last_name": "input[name=\"lastName\"]",
        "full_name": null,
        "email": "input[name=\"email\"]",
        "phone": "input[name=\"phone\"]",
        "resume_upload": "input[type=\"file\"]",
        "cover_letter_upload": "input[type=\"file\"]",
        "cover_letter_text": "textarea[name=\"coverLetter\"]",
        "linkedin_url": "input[name=\"linkedin\"]",
        "github_url": null,
        "portfolio_url": null,
        "current_company": "input[name=\"companyName\"]",
        "current_title": "input[name=\"jobTitle\"]",
        "location": "input[name=\"location\"]",
        "city": "input[name=\"city\"]",
        "country": "input[name=\"country\"]",
        "submit_button": "button[type=\"submit\"]",
        "next_button": "button:has-text(\"Next\")"
      },
      "notes": "Standard standard form inputs."
    }
  ],
  "fallback_regex": {
    "first_name": ["first\\s*name", "given\\s*name", "forename"],
    "last_name": ["last\\s*name", "surname", "family\\s*name"],
    "full_name": ["full\\s*name", "your\\s*name", "^name$"],
    "email": ["e-?mail", "email\\s*address"],
    "phone": ["phone", "mobile", "contact\\s*number", "tel", "cell\\s*phone"],
    "resume_upload": ["resume", "cv", "curriculum\\s*vitae", "upload\\s*resume"],
    "cover_letter_upload": ["cover\\s*letter", "letter\\s*of\\s*motivation"],
    "cover_letter_text": ["cover\\s*letter", "additional\\s*information", "message\\s*to\\s*hiring\\s*manager"],
    "linkedin_url": ["linkedin", "linked\\s*in"],
    "github_url": ["github", "git\\s*hub"],
    "portfolio_url": ["portfolio", "website", "personal\\s*site"],
    "current_company": ["current\\s*company", "employer", "company"],
    "current_title": ["current\\s*title", "job\\s*title", "role"],
    "location": ["location", "address"],
    "city": ["city", "town"],
    "country": ["country", "nation"]
  }
}
