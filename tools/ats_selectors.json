{
  "platforms": [
    {
      "platform_name": "Greenhouse",
      "url_pattern": "(?:boards\\.greenhouse\\.io|job-boards\\.greenhouse\\.io|board\\.greenhouse\\.io)",
      "selectors": {
        "first_name": "input#first_name, input[name*=\"first_name\" i], [aria-label*=\"First Name\" i]",
        "last_name": "input#last_name, input[name*=\"last_name\" i], [aria-label*=\"Last Name\" i]",
        "full_name": null,
        "email": "input#email, input[type=\"email\"], [aria-label*=\"Email\" i]",
        "phone": "input#phone, input[type=\"tel\"], [aria-label*=\"Phone\" i]",
        "resume_upload": "input#resume[type=\"file\"], input[type=\"file\"][name*=\"resume\" i], input[type=\"file\"][id*=\"resume\" i], input[type=\"file\"]",
        "cover_letter_upload": "input#cover_letter[type=\"file\"], input[type=\"file\"][name*=\"cover\" i], input[type=\"file\"][id*=\"cover\" i]",
        "cover_letter_text": "textarea#cover_letter_text, textarea[aria-label*=\"Cover\" i], textarea[name*=\"cover\" i]",
        "linkedin_url": "input[aria-label*=\"LinkedIn\" i], input[autocomplete*=\"linkedin\" i], input[id*=\"linkedin\" i], input[name*=\"linkedin\" i]",
        "github_url": "input[aria-label*=\"GitHub\" i], input[id*=\"github\" i], input[name*=\"github\" i]",
        "portfolio_url": "input[aria-label*=\"Portfolio\" i], input[aria-label*=\"Website\" i], input[id*=\"portfolio\" i], input[name*=\"portfolio\" i]",
        "current_company": "input#company, input[id*=\"current_company\" i], input[name*=\"company\" i], [aria-label*=\"Company\" i]",
        "current_title": "input#title, input[id*=\"current_title\" i], input[name*=\"title\" i], [aria-label*=\"Title\" i]",
        "location": "input#location, input[id*=\"location\" i], input[name*=\"location\" i], [aria-label*=\"Location\" i]",
        "city": null,
        "country": null,
        "submit_button": "button[type=\"submit\"]:has-text(\"Submit application\"), button:has-text(\"Submit application\"), button#submit_app, input#submit_app, button[type=\"submit\"]:has-text(\"Submit\"), button:has-text(\"Submit Application\")",
        "next_button": null
      },
      "notes": "Supports both classic Greenhouse (boards.greenhouse.io) and modern React/Remix boards (job-boards.greenhouse.io)."
    },
    {
      "platform_name": "Lever",
      "url_pattern": "jobs\\.lever\\.co",
      "selectors": {
        "first_name": null,
        "last_name": null,
        "full_name": "input[name=\"name\"], input[data-qa=\"name-input\"]",
        "email": "input[name=\"email\"], input[data-qa=\"email-input\"]",
        "phone": "input[name=\"phone\"], input[data-qa=\"phone-input\"]",
        "resume_upload": "input[name=\"resume\"][type=\"file\"], input#resume-upload-input, input[type=\"file\"]",
        "cover_letter_upload": "input[name=\"coverLetter\"][type=\"file\"]",
        "cover_letter_text": "textarea[name=\"comments\"], textarea[name=\"additional-information\"]",
        "linkedin_url": "input[name=\"urls[LinkedIn]\"], input[name*=\"linkedin\" i]",
        "github_url": "input[name=\"urls[GitHub]\"], input[name*=\"github\" i]",
        "portfolio_url": "input[name=\"urls[Portfolio]\"], input[name*=\"portfolio\" i]",
        "current_company": "input[name=\"org\"], input[data-qa=\"org-input\"]",
        "current_title": null,
        "location": "input[name=\"location\"], input[data-qa=\"location-input\"], input#location-input",
        "city": null,
        "country": null,
        "submit_button": "button#btn-submit, button.postings-btn.template-btn-submit, button.template-btn-submit, button[data-qa=\"btn-submit\"], button:has-text(\"SUBMIT APPLICATION\"), button:has-text(\"Submit application\")",
        "next_button": null
      },
      "notes": "Lever uses a single 'name' field for full name. Cover letter is often just a text area for 'Additional information'."
    },
    {
      "platform_name": "Ashby",
      "url_pattern": "jobs\\.ashbyhq\\.com",
      "selectors": {
        "first_name": "input#_systemfield_first_name, input[name='_systemfield_first_name'], [aria-label*='First Name' i], input[name*='first' i]",
        "last_name": "input#_systemfield_last_name, input[name='_systemfield_last_name'], [aria-label*='Last Name' i], input[name*='last' i]",
        "full_name": "input#_systemfield_name, input[name='_systemfield_name'], [aria-label*='Name' i], input[name*='name' i]",
        "email": "input#_systemfield_email, input[name='_systemfield_email'], [aria-label*='Email' i], input[type='email'], input[name*='email' i]",
        "phone": "input#_systemfield_phone, input[name='_systemfield_phone'], [aria-label*='Phone' i], input[type='tel'], input[name*='phone' i]",
        "resume_upload": "input#_systemfield_resume[type='file'], input[id*='resume' i][type='file'], input[type='file'][accept*='pdf'], input[type='file']",
        "cover_letter_upload": "input#_systemfield_cover_letter[type='file'], input[id*='cover' i][type='file'], input[type='file']",
        "cover_letter_text": "textarea[aria-label*='Cover' i], [aria-label*='Cover' i], textarea",
        "linkedin_url": "input[name*='linkedin' i], [aria-label*='LinkedIn' i]",
        "github_url": "input[name*='github' i], [aria-label*='GitHub' i]",
        "portfolio_url": "input[name*='portfolio' i], [aria-label*='Portfolio' i]",
        "current_company": "input#_systemfield_company, [aria-label*='Company' i], input[name*='company' i]",
        "current_title": "input#_systemfield_title, [aria-label*='Title' i], input[name*='title' i]",
        "location": "[aria-label*='Location' i]:not([placeholder*='Start typing']), input[name*='location' i]:not([placeholder*='Start typing'])",
        "city": "[aria-label*='City' i], input[name*='city' i]",
        "country": "[aria-label*='Country' i], input[name*='country' i]",
        "submit_button": "button.ashby-application-form-submit-button, button:has-text(\"Submit Application\"), button:has-text(\"Submit application\"), button[type=\"submit\"]",
        "next_button": "button:has-text(\"Next\"), button[aria-label*=\"Next\" i]"
      },
      "notes": "Ashby forms reside at /application and use _systemfield IDs for core fields and .ashby-application-form-submit-button."
    },
    {
      "platform_name": "Workday",
      "url_pattern": "myworkdayjobs\\.com",
      "selectors": {
        "first_name": "[data-automation-id=\"legalNameSection_firstName\"]",
        "last_name": "[data-automation-id=\"legalNameSection_lastName\"]",
        "full_name": null,
        "email": "[data-automation-id=\"email\"]",
        "phone": "[data-automation-id=\"phone-number\"]",
        "resume_upload": "[data-automation-id=\"file-upload-input-ref\"]",
        "cover_letter_upload": "[data-automation-id=\"file-upload-input-ref\"]",
        "cover_letter_text": null,
        "linkedin_url": "[data-automation-id=\"linkedin\"]",
        "github_url": "[data-automation-id=\"github\"]",
        "portfolio_url": "[data-automation-id=\"portfolio\"]",
        "current_company": "[data-automation-id=\"company\"]",
        "current_title": "[data-automation-id=\"jobTitle\"]",
        "location": "[data-automation-id=\"addressSection_city\"]",
        "city": "[data-automation-id=\"addressSection_city\"]",
        "country": "[data-automation-id=\"addressSection_countryRegion\"]",
        "submit_button": "[data-automation-id=\"submit\"]",
        "next_button": "[data-automation-id=\"bottom-navigation-next-button\"]"
      },
      "notes": "Workday is a multi-step wizard. Always uses data-automation-id attributes."
    },
    {
      "platform_name": "SmartRecruiters",
      "url_pattern": "(?:smartrecruiters\\.com|careers\\.smartrecruiters\\.com)",
      "selectors": {
        "first_name": "[data-test=\"first-name-input\"]",
        "last_name": "[data-test=\"last-name-input\"]",
        "full_name": null,
        "email": "[data-test=\"email-input\"]",
        "phone": "[data-test=\"phone-input\"]",
        "resume_upload": "[data-test=\"file-upload-input\"]",
        "cover_letter_upload": "[data-test=\"cover-letter-upload\"]",
        "cover_letter_text": "[data-test=\"cover-letter-textarea\"]",
        "linkedin_url": "[data-test=\"linkedin-input\"]",
        "github_url": "[data-test=\"github-input\"]",
        "portfolio_url": "[data-test=\"portfolio-input\"]",
        "current_company": "[data-test=\"current-company-input\"]",
        "current_title": "[data-test=\"current-title-input\"]",
        "location": "[data-test=\"location-input\"]",
        "city": "[data-test=\"city-input\"]",
        "country": "[data-test=\"country-input\"]",
        "submit_button": "[data-test=\"submit-button\"]",
        "next_button": "[data-test=\"next-button\"]"
      },
      "notes": "Relies heavily on data-test attributes."
    },
    {
      "platform_name": "LinkedIn Easy Apply",
      "url_pattern": "linkedin\\.com/jobs/view/.*\\?apply=true",
      "selectors": {
        "first_name": "input[id*=\"first-name\"]",
        "last_name": "input[id*=\"last-name\"]",
        "full_name": null,
        "email": "input[id*=\"email\"]",
        "phone": "input[id*=\"phone\"]",
        "resume_upload": "input[type=\"file\"][name*=\"file\"]",
        "cover_letter_upload": null,
        "cover_letter_text": null,
        "linkedin_url": null,
        "github_url": null,
        "portfolio_url": null,
        "current_company": null,
        "current_title": null,
        "location": null,
        "city": null,
        "country": null,
        "submit_button": "button[aria-label*=\"Submit\"]",
        "next_button": "button[aria-label*=\"Continue\"], button[aria-label*=\"Next\"]"
      },
      "notes": "Modal dialog based. Multi-step forms inside div.jobs-easy-apply-content."
    },
